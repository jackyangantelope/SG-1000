+/* RP2350 port indexed renderer palette accessor, without byte-swapped RGB565. */
+uint16 retro8_tms_color(unsigned index) {
+    const uint8 *p = tms_palette[(sms.console == CONSOLE_COLECO ? 32 : 16) + (index & 15)];
+    return (uint16)(((p[0] >> 3) << 10) | ((p[1] >> 3) << 5) | (p[2] >> 3));
+}
